# Vite emits fingerprinted files under /assets, so they can be cached until the
# filename changes on a later build
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, do not aggressively cache to avoid serving user stale build
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
